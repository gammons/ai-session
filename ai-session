#!/usr/bin/env bash
set -euo pipefail

# ai-session — Persist Claude Code conversation transcripts as git artifacts
# Usage: ai-session <command> [options]

VERSION="0.2.0"
AI_DIR=".ai"
SESSIONS_DIR="$AI_DIR/sessions"
BREADCRUMB="$AI_DIR/.active-session"
STALE_HOURS=2
CONFIG_FILE="$AI_DIR/config.json"
DEFAULT_CACHE_BASE="$HOME/.ai-sessions"

# ─── Helpers ──────────────────────────────────────────────────────────────────

die()  { printf 'error: %s\n' "$1" >&2; exit 1; }
info() { printf '%s\n' "$1" >&2; }

slugify() {
  # kebab-case, truncate to 40 chars
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' \
    | cut -c1-40
}

short_id() {
  printf '%s' "$1" | cut -c1-8
}

now_iso() {
  date -u '+%Y-%m-%dT%H:%M:%SZ'
}

now_folder_prefix() {
  date -u '+%Y-%m-%d_%H%MZ'
}

gen_uuid() {
  if command -v uuidgen &>/dev/null; then
    uuidgen | tr '[:upper:]' '[:lower:]'
  elif [[ -r /proc/sys/kernel/random/uuid ]]; then
    cat /proc/sys/kernel/random/uuid
  else
    python3 -c 'import uuid; print(uuid.uuid4())'
  fi
}

file_age_hours() {
  local file="$1"
  if [[ ! -f "$file" ]]; then
    echo 9999
    return
  fi
  local now file_epoch
  now=$(date +%s)
  file_epoch=$(stat -c '%Y' "$file" 2>/dev/null || stat -f '%m' "$file" 2>/dev/null)
  echo $(( (now - file_epoch) / 3600 ))
}

repo_name() {
  basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
}

current_branch() {
  git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null || echo "unknown"
}

git_author() {
  git config user.name 2>/dev/null || echo "unknown"
}

# Derive Claude Code project key from pwd
claude_project_key() {
  local toplevel
  toplevel="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  printf '%s' "$toplevel" | sed 's|[^a-zA-Z0-9-]|-|g'
}

# Find most recent JSONL in Claude projects dir
find_latest_jsonl() {
  local key="$1"
  local projects_dir="$HOME/.claude/projects/$key"
  if [[ ! -d "$projects_dir" ]]; then
    return 1
  fi
  # Find most recently modified .jsonl
  find "$projects_dir" -maxdepth 1 -name '*.jsonl' -printf '%T@\t%p\n' 2>/dev/null \
    | sort -rn | head -1 | cut -f2
}

# Convert JSONL transcript to Markdown
jsonl_to_markdown() {
  local jsonl_path="$1"
  jq -r '
    if .type == "human" then
      "\n## User\n\n" + (
        if (.message | type) == "array" then
          [.message[] | select(.type == "text") | .text] | join("\n")
        elif (.message | type) == "object" and .message.content then
          if (.message.content | type) == "array" then
            [.message.content[] | select(.type == "text") | .text] | join("\n")
          else
            (.message.content // "")
          end
        elif (.message | type) == "string" then
          .message
        else
          ""
        end
      )
    elif .type == "assistant" then
      "\n## Assistant\n\n" + (
        if (.message | type) == "object" and .message.content then
          if (.message.content | type) == "array" then
            [.message.content[] | select(.type == "text") | .text] | join("\n")
          else
            (.message.content // "")
          end
        elif (.message | type) == "string" then
          .message
        else
          ""
        end
      )
    else
      empty
    end
  ' "$jsonl_path" 2>/dev/null || true
}

# Compute sha256 hash of a file
file_sha256() {
  if command -v sha256sum &>/dev/null; then
    sha256sum "$1" | cut -d' ' -f1
  elif command -v shasum &>/dev/null; then
    shasum -a 256 "$1" | cut -d' ' -f1
  else
    echo "unknown"
  fi
}

# Scrub secrets from a file in-place
_scrub_secrets() {
  local file="$1"
  [[ -f "$file" ]] || return 0

  # Load user-defined patterns from .ai/scrub-patterns if present
  local toplevel
  toplevel="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  local custom_patterns_file="$toplevel/$AI_DIR/scrub-patterns"

  # Built-in patterns (sed ERE)
  # Note: GNU sed supports the I flag for case-insensitive matching
  sed -E -i \
    -e 's/AKIA[0-9A-Z]{16}/[REDACTED]/g' \
    -e 's/gh[pousr]_[A-Za-z0-9_]{36,}/[REDACTED]/g' \
    -e 's/xox[baprs]-[A-Za-z0-9-]+/[REDACTED]/g' \
    -e 's/eyJ[A-Za-z0-9_-]{20,}\.eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]+/[REDACTED]/g' \
    -e 's/Bearer [A-Za-z0-9\._~+/=-]+/Bearer [REDACTED]/g' \
    -e 's/-----BEGIN[A-Z ]*PRIVATE KEY-----/[REDACTED PRIVATE KEY]/g' \
    -e 's/-----END[A-Z ]*PRIVATE KEY-----/[REDACTED END KEY]/g' \
    "$file"

  # Scrub private key bodies (base64 lines between BEGIN/END markers)
  sed -i '/\[REDACTED PRIVATE KEY\]/,/\[REDACTED END KEY\]/{/\[REDACTED/!s/.*/[REDACTED]/}' "$file"

  # Generic key=value patterns (manual case-insensitive via character classes)
  local kw='[Kk][Ee][Yy]|[Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Aa][Pp][Ii]_[Kk][Ee][Yy]|[Aa][Pp][Ii][Kk][Ee][Yy]|[Aa][Uu][Tt][Hh]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]_[Kk][Ee][Yy]|[Aa][Cc][Cc][Ee][Ss][Ss]_[Tt][Oo][Kk][Ee][Nn]|[Cc][Ll][Ii][Ee][Nn][Tt]_[Ss][Ee][Cc][Rr][Ee][Tt]|[Ss][Ii][Gg][Nn][Ii][Nn][Gg]_[Kk][Ee][Yy]'
  # Double-quoted values (handles = and := operators)
  sed -E -i "s/($kw)([[:space:]]*:?=[[:space:]]*)\"[^\"]{8,}\"/\1\2\"[REDACTED]\"/g" "$file"
  # Single-quoted values
  sed -E -i "s/($kw)([[:space:]]*:?=[[:space:]]*)'[^']{8,}'/\1\2'[REDACTED]'/g" "$file"
  # Unquoted values
  sed -E -i "s/($kw)([[:space:]]*:?=[[:space:]]*)[^[:space:]\"']{8,}/\1\2[REDACTED]/g" "$file"
  # Colon-separated (key: value)
  sed -E -i "s/($kw)([[:space:]]*:[[:space:]]+)\"[^\"]{8,}\"/\1\2\"[REDACTED]\"/g" "$file"
  sed -E -i "s/($kw)([[:space:]]*:[[:space:]]+)[^[:space:]\"']{8,}/\1\2[REDACTED]/g" "$file"

  # Apply user-defined patterns
  if [[ -f "$custom_patterns_file" ]]; then
    while IFS= read -r pattern; do
      # Skip blank lines and comments
      [[ -z "$pattern" || "$pattern" =~ ^[[:space:]]*# ]] && continue
      sed -E -i "s/$pattern/[REDACTED]/g" "$file" 2>/dev/null || true
    done < "$custom_patterns_file"
  fi
}

# Check for remaining secret-like patterns; returns 1 if found
_check_secrets() {
  local dir="$1"
  local found=false

  local -a patterns=(
    'AKIA[0-9A-Z]{16}'
    'gh[pousr]_[A-Za-z0-9_]{36,}'
    'xox[baprs]-[A-Za-z0-9-]+'
    'eyJ[A-Za-z0-9_-]{20,}\.eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]+'
    '-----BEGIN[A-Z ]*PRIVATE KEY-----'
  )

  for file in "$dir"/transcript.*; do
    [[ -f "$file" ]] || continue
    for pattern in "${patterns[@]}"; do
      if grep -qEi "$pattern" "$file" 2>/dev/null; then
        info "warning: potential secret found in $(basename "$file") matching: $pattern"
        found=true
      fi
    done
  done

  if [[ "$found" == true ]]; then
    info "error: secrets detected after scrubbing — aborting session creation"
    info "hint: review transcripts or add patterns to .ai/scrub-patterns"
    rm -rf "$dir"
    return 1
  fi
  return 0
}

# Read a trailer value from git commit message
get_trailer() {
  local commit="$1" trailer="$2"
  git log -1 --format='%(trailers:key='"$trailer"',valueonly)' "$commit" 2>/dev/null | head -1
}

# ─── External Session Repo Helpers ────────────────────────────────────────────

# Read .ai/config.json — sets _SESSION_REPO_URL and _SESSION_CACHE_DIR globals.
# Returns 1 only if config file is missing (pre-init state).
# _SESSION_REPO_URL may be empty (no remote configured).
_read_config() {
  _SESSION_REPO_URL=""
  _SESSION_CACHE_DIR=""

  local toplevel
  toplevel="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  local config="$toplevel/$CONFIG_FILE"

  [[ -f "$config" ]] || return 1

  _SESSION_REPO_URL=$(jq -r '.session_repo // empty' "$config" 2>/dev/null || true)

  local custom_cache
  custom_cache=$(jq -r '.local_cache // empty' "$config" 2>/dev/null || true)

  local project
  project=$(repo_name)

  if [[ -n "$custom_cache" ]]; then
    _SESSION_CACHE_DIR="$custom_cache/$project"
  else
    _SESSION_CACHE_DIR="$DEFAULT_CACHE_BASE/$project"
  fi

  return 0
}

# Ensure local session repo exists. Clone from remote if configured, otherwise git init.
_ensure_session_repo() {
  _read_config || die "no session config found — run 'ai-session init' first"

  if [[ -d "$_SESSION_CACHE_DIR/.git" ]]; then
    # Already exists — pull if remote configured
    if [[ -n "$_SESSION_REPO_URL" ]]; then
      git -C "$_SESSION_CACHE_DIR" pull --rebase --quiet 2>/dev/null || true
    fi
  else
    mkdir -p "$(dirname "$_SESSION_CACHE_DIR")"
    if [[ -n "$_SESSION_REPO_URL" ]]; then
      git clone "$_SESSION_REPO_URL" "$_SESSION_CACHE_DIR" --quiet 2>/dev/null || {
        # Repo may be empty — init and set remote
        mkdir -p "$_SESSION_CACHE_DIR"
        git -C "$_SESSION_CACHE_DIR" init --quiet
        git -C "$_SESSION_CACHE_DIR" remote add origin "$_SESSION_REPO_URL" 2>/dev/null || true
      }
    else
      # No remote — just init a local repo
      mkdir -p "$_SESSION_CACHE_DIR"
      git -C "$_SESSION_CACHE_DIR" init --quiet
    fi
  fi
}

# git add -A && commit in the session repo. Push only if remote configured.
_session_repo_commit_and_push() {
  local msg="${1:-ai-session update}"

  _read_config || return 0
  [[ -d "$_SESSION_CACHE_DIR/.git" ]] || return 0

  git -C "$_SESSION_CACHE_DIR" add -A 2>/dev/null || true
  git -C "$_SESSION_CACHE_DIR" diff --cached --quiet 2>/dev/null && return 0

  git -C "$_SESSION_CACHE_DIR" commit -m "$msg" --quiet 2>/dev/null || true

  # Only push if a remote is configured
  if [[ -n "$_SESSION_REPO_URL" ]]; then
    git -C "$_SESSION_CACHE_DIR" push --quiet 2>/dev/null || true
  fi
}

# Returns the sessions base directory — external cache, or in-tree for pre-init repos.
_resolve_sessions_base() {
  if _read_config; then
    _ensure_session_repo
    echo "$_SESSION_CACHE_DIR/sessions"
  else
    # Pre-init fallback: in-tree for backward compat
    local toplevel
    toplevel="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    echo "$toplevel/$SESSIONS_DIR"
  fi
}

# Find a session dir by short_id glob, checking the right location.
_resolve_session_dir() {
  local target_id="$1"
  local sessions_base
  sessions_base=$(_resolve_sessions_base)

  for d in "$sessions_base"/*"__${target_id}"/; do
    if [[ -d "$d" ]]; then
      echo "$d"
      return 0
    fi
  done
  return 1
}

# Resolve a trailer path to an absolute directory.
# External paths look like <project>/sessions/<folder>, in-tree like .ai/sessions/<folder>.
_resolve_trailer_path() {
  local trailer_path="$1" toplevel="$2"

  # If it starts with .ai/, it's in-tree
  if [[ "$trailer_path" == .ai/* ]]; then
    echo "$toplevel/$trailer_path"
    return 0
  fi

  # Otherwise it's external — resolve via config
  if _read_config 2>/dev/null; then
    local cache_base
    if [[ -n "$(jq -r '.local_cache // empty' "$toplevel/$CONFIG_FILE" 2>/dev/null)" ]]; then
      cache_base=$(jq -r '.local_cache' "$toplevel/$CONFIG_FILE")
    else
      cache_base="$DEFAULT_CACHE_BASE"
    fi
    echo "$cache_base/$trailer_path"
    return 0
  fi

  # Fallback: try in-tree
  echo "$toplevel/$trailer_path"
}

# ─── Subcommands ──────────────────────────────────────────────────────────────

cmd_init() {
  local repo_url="" cache_path=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)  repo_url="$2"; shift 2 ;;
      --cache) cache_path="$2"; shift 2 ;;
      *)       die "unknown option: $1" ;;
    esac
  done

  local toplevel
  toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not a git repository"
  cd "$toplevel"

  # Create .ai directory structure
  mkdir -p "$AI_DIR"

  # Always gitignore sessions/ — they live in the external cache
  cat > "$AI_DIR/.gitignore" << 'EOF'
.active-session
sessions/
EOF

  # Write .ai/config.json — always, with session_repo only if --repo provided
  local config_obj
  config_obj=$(jq -n \
    --arg repo "$repo_url" \
    --arg cache "$cache_path" \
    '(if $repo != "" then {session_repo: $repo} else {} end) + (if $cache != "" then {local_cache: $cache} else {} end)')
  echo "$config_obj" > "$CONFIG_FILE"
  info "ai-session: wrote $CONFIG_FILE"

  # If --repo provided, validate the remote
  if [[ -n "$repo_url" ]]; then
    if ! git ls-remote "$repo_url" &>/dev/null; then
      info "warning: remote $repo_url does not appear to exist"
      if command -v gh &>/dev/null; then
        local repo_path
        repo_path=$(echo "$repo_url" | sed -E 's|.*[:/]([^/]+/[^/]+?)(\.git)?$|\1|')
        info "hint: create it with: gh repo create $repo_path --private"
      fi
    fi
  fi

  # Always init local session repo
  _read_config
  _ensure_session_repo

  # If --repo provided, ensure remote is set on the local cache
  if [[ -n "$repo_url" ]]; then
    local existing_remote
    existing_remote=$(git -C "$_SESSION_CACHE_DIR" remote get-url origin 2>/dev/null || true)
    if [[ -z "$existing_remote" ]]; then
      git -C "$_SESSION_CACHE_DIR" remote add origin "$repo_url" 2>/dev/null || true
    elif [[ "$existing_remote" != "$repo_url" ]]; then
      git -C "$_SESSION_CACHE_DIR" remote set-url origin "$repo_url" 2>/dev/null || true
    fi
  fi

  info "ai-session: session cache at $_SESSION_CACHE_DIR"

  # Install git hooks
  local hooks_dir="$toplevel/.git/hooks"
  mkdir -p "$hooks_dir"

  _install_hook "$hooks_dir/prepare-commit-msg" "_hook_prepare_commit_msg" \
    'ai-session _hook-prepare-commit-msg "$@"'

  _install_hook "$hooks_dir/post-commit" "_hook_post_commit" \
    'ai-session _hook-post-commit'

  _install_hook "$hooks_dir/pre-push" "_hook_pre_push" \
    'ai-session _hook-pre-push "$@"'

  # Create .ai/scrub-patterns with examples (if not present)
  if [[ ! -f "$AI_DIR/scrub-patterns" ]]; then
    cat > "$AI_DIR/scrub-patterns" << 'EOF'
# ai-session scrub-patterns — Custom secret patterns (sed ERE syntax, one per line)
# These are applied IN ADDITION to built-in patterns during transcript scrubbing.
# Each pattern is used as: sed -E "s/<pattern>/[REDACTED]/g"
#
# Examples:
# my-service-key-[A-Za-z0-9]{32}
# PRIVATE-[0-9a-f]{64}
EOF
  fi

  # Add Claude Code hook to .claude/settings.json
  _install_claude_hook "$toplevel"

  info "ai-session: initialized in $toplevel"
  info "  .ai/ directory created"
  info "  .ai/scrub-patterns created (add custom secret patterns)"
  info "  git hooks installed (prepare-commit-msg, post-commit, pre-push)"
  info "  Claude Code hook added to .claude/settings.local.json"
}

_install_hook() {
  local hook_file="$1" marker="$2" command="$3"

  if [[ -f "$hook_file" ]]; then
    # Check if already installed
    if grep -q "$marker" "$hook_file" 2>/dev/null; then
      return 0
    fi
    # Append to existing hook
    cat >> "$hook_file" << EOF

# ai-session: $marker
$command
EOF
  else
    cat > "$hook_file" << EOF
#!/usr/bin/env bash
# ai-session: $marker
$command
EOF
  fi
  chmod +x "$hook_file"
}

_install_claude_hook() {
  local toplevel="$1"
  local settings_dir="$toplevel/.claude"
  local settings_file="$settings_dir/settings.local.json"

  mkdir -p "$settings_dir"

  # Check if hook already exists in either settings.json or settings.local.json
  for f in "$settings_dir/settings.json" "$settings_dir/settings.local.json"; do
    if [[ -f "$f" ]] && jq -e '.hooks.PostToolUse[]? | .hooks[]? | select(.command == "ai-session _mark-active")' "$f" &>/dev/null; then
      return 0
    fi
  done

  if [[ -f "$settings_file" ]]; then
    local tmp
    tmp=$(mktemp)
    jq '
      .hooks //= {} |
      .hooks.PostToolUse //= [] |
      .hooks.PostToolUse += [{"matcher": "Edit|Write|Bash|NotebookEdit", "hooks": [{"type": "command", "command": "ai-session _mark-active"}]}]
    ' "$settings_file" > "$tmp" && mv "$tmp" "$settings_file"
  else
    cat > "$settings_file" << 'EOF'
{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "ai-session _mark-active" }
        ]
      }
    ]
  }
}
EOF
  fi
}

cmd_new() {
  local goal="" transcript_path="" from_stdin=false auto_detect=false
  local model="" author="" repo_path=""
  local -a links=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --goal)       goal="$2"; shift 2 ;;
      --transcript) transcript_path="$2"; shift 2 ;;
      --stdin)      from_stdin=true; shift ;;
      --auto)       auto_detect=true; shift ;;
      --model)      model="$2"; shift 2 ;;
      --author)     author="$2"; shift 2 ;;
      --link)       links+=("$2"); shift 2 ;;
      --repo)       repo_path="$2"; shift 2 ;;
      *)            die "unknown option: $1" ;;
    esac
  done

  [[ -n "$goal" ]] || die "missing --goal"

  local session_id claude_session_id=""
  local slug prefix folder_name session_dir

  # Read breadcrumb if available
  if [[ -f "$BREADCRUMB" ]]; then
    claude_session_id=$(jq -r '.session_id // empty' "$BREADCRUMB" 2>/dev/null || true)
    [[ -z "$model" ]] && model=$(jq -r '.model // empty' "$BREADCRUMB" 2>/dev/null || true)
  fi

  # Generate session ID
  if [[ -n "$claude_session_id" ]]; then
    session_id="$claude_session_id"
  else
    session_id=$(gen_uuid)
  fi

  local sid
  sid=$(short_id "$session_id")
  slug=$(slugify "$goal")
  prefix=$(now_folder_prefix)
  folder_name="${prefix}_${slug}__${sid}"

  # Determine target directory — always external
  local base_dir
  if [[ -n "$repo_path" ]]; then
    base_dir="$repo_path"
  elif _read_config 2>/dev/null; then
    _ensure_session_repo
    base_dir="$_SESSION_CACHE_DIR"
  else
    # Pre-init fallback: in-tree for backward compat
    base_dir="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    local existing_dir_intree
    existing_dir_intree=$(find "$base_dir/$SESSIONS_DIR" -maxdepth 1 -type d -name "*__${sid}" 2>/dev/null | head -1 || true)
    if [[ -n "$existing_dir_intree" ]]; then
      session_dir="$existing_dir_intree"
    else
      session_dir="$base_dir/$SESSIONS_DIR/$folder_name"
    fi
    mkdir -p "$session_dir"
  fi
  if [[ -z "${session_dir:-}" ]]; then
    # Reuse existing session folder if one with this short_id already exists
    local existing_dir
    existing_dir=$(find "$base_dir/sessions" -maxdepth 1 -type d -name "*__${sid}" 2>/dev/null | head -1 || true)
    if [[ -n "$existing_dir" ]]; then
      session_dir="$existing_dir"
    else
      session_dir="$base_dir/sessions/$folder_name"
    fi
    mkdir -p "$session_dir"
  fi

  # Handle transcript
  local transcript_hash=""
  if [[ "$auto_detect" == true ]]; then
    local key jsonl_src
    key=$(claude_project_key)
    jsonl_src=$(find_latest_jsonl "$key" || true)
    if [[ -n "$jsonl_src" ]]; then
      cp "$jsonl_src" "$session_dir/transcript.jsonl"
      jsonl_to_markdown "$session_dir/transcript.jsonl" > "$session_dir/transcript.md"
      transcript_hash="sha256:$(file_sha256 "$session_dir/transcript.jsonl")"
      # Derive model from JSONL if not set
      if [[ -z "$model" ]]; then
        model=$(jq -r 'select(.model) | .model' "$session_dir/transcript.jsonl" 2>/dev/null | head -1 || true)
      fi
    fi
  elif [[ "$from_stdin" == true ]]; then
    cat > "$session_dir/transcript.md"
    transcript_hash="sha256:$(file_sha256 "$session_dir/transcript.md")"
  elif [[ -n "$transcript_path" ]]; then
    cp "$transcript_path" "$session_dir/"
    local basename_t
    basename_t=$(basename "$transcript_path")
    transcript_hash="sha256:$(file_sha256 "$session_dir/$basename_t")"
  fi

  # Scrub secrets from all transcript files
  for _tf in "$session_dir"/transcript.*; do
    [[ -f "$_tf" ]] && _scrub_secrets "$_tf"
  done
  _check_secrets "$session_dir" || return 1

  [[ -z "$author" ]] && author=$(git_author)
  [[ -z "$model" ]] && model="unknown"

  # Build links JSON array
  local links_json="[]"
  if [[ ${#links[@]} -gt 0 ]]; then
    links_json=$(printf '%s\n' "${links[@]}" | jq -R . | jq -s .)
  fi

  # Write meta.json
  jq -n \
    --arg session_id "$session_id" \
    --arg short_id "$sid" \
    --arg created_at "$(now_iso)" \
    --arg author "$author" \
    --arg repo "$(repo_name)" \
    --arg branch "$(current_branch)" \
    --arg goal "$goal" \
    --arg model "$model" \
    --argjson links "$links_json" \
    --arg claude_session_id "$claude_session_id" \
    --arg transcript_hash "$transcript_hash" \
    '{
      session_id: $session_id,
      short_id: $short_id,
      created_at: $created_at,
      author: $author,
      repo: $repo,
      branch: $branch,
      goal: $goal,
      model: $model,
      links: $links,
      commits: [],
      pr: null,
      claude_session_id: (if $claude_session_id == "" then null else $claude_session_id end),
      transcript_hash: (if $transcript_hash == "" then null else $transcript_hash end)
    }' > "$session_dir/meta.json"

  # Determine output path for trailers
  local output_path
  if [[ -n "$repo_path" ]]; then
    output_path="sessions/$folder_name"
  elif _read_config 2>/dev/null; then
    local project
    project=$(repo_name)
    output_path="$project/sessions/$folder_name"
  else
    # Pre-init fallback: in-tree path
    output_path="$SESSIONS_DIR/$folder_name"
  fi

  # Output the path for callers
  echo "$output_path"
}

cmd_attach() {
  [[ $# -ge 2 ]] || die "usage: ai-session attach <short-id> <sha>..."

  local target_id="$1"; shift
  local -a shas=("$@")

  local session_dir
  session_dir=$(_resolve_session_dir "$target_id") || die "session not found: $target_id"

  local meta="$session_dir/meta.json"
  [[ -f "$meta" ]] || die "meta.json not found in $session_dir"

  # Add commits to meta.json
  local tmp
  tmp=$(mktemp)
  jq --argjson new_commits "$(printf '%s\n' "${shas[@]}" | jq -R . | jq -s .)" \
    '.commits = (.commits + $new_commits | unique)' "$meta" > "$tmp" && mv "$tmp" "$meta"

  info "attached ${#shas[@]} commit(s) to session $target_id"

  # Commit (and push if remote configured) to session repo
  _session_repo_commit_and_push "attach commits to session $target_id"
}

cmd_pr() {
  local -a session_ids=()
  local pr_number=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --pr) pr_number="$2"; shift 2 ;;
      *)    session_ids+=("$1"); shift ;;
    esac
  done

  local toplevel
  toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not a git repository"

  # If no PR specified, try current branch
  if [[ -z "$pr_number" ]]; then
    pr_number=$(gh pr view --json number -q '.number' 2>/dev/null || true)
    [[ -n "$pr_number" ]] || die "no open PR found for current branch; use --pr <number>"
  fi

  local pr_url
  pr_url=$(gh pr view "$pr_number" --json url -q '.url' 2>/dev/null) || die "cannot find PR #$pr_number"

  # If no session IDs, scan commits on this branch vs base
  if [[ ${#session_ids[@]} -eq 0 ]]; then
    local base
    base=$(gh pr view "$pr_number" --json baseRefName -q '.baseRefName' 2>/dev/null || echo "main")
    while IFS= read -r sid; do
      [[ -n "$sid" ]] && session_ids+=("$sid")
    done < <(git log "$base"..HEAD --format='%(trailers:key=Claude-Session,valueonly)' 2>/dev/null | grep -v '^$' | sort -u)
  fi

  [[ ${#session_ids[@]} -gt 0 ]] || { info "no sessions found to link"; return 0; }

  local sessions_base
  sessions_base=$(_resolve_sessions_base)

  # Update each session's meta.json with PR link
  for sid in "${session_ids[@]}"; do
    for d in "$sessions_base"/*"__${sid}"/; do
      if [[ -d "$d" && -f "$d/meta.json" ]]; then
        local tmp
        tmp=$(mktemp)
        jq --arg pr "$pr_url" '.pr = $pr' "$d/meta.json" > "$tmp" && mv "$tmp" "$d/meta.json"
      fi
    done
  done

  # Commit (and push if remote configured) to session repo
  _session_repo_commit_and_push "link sessions to PR #$pr_number"

  # Build AI Sessions table for PR body
  local table
  table=$(_build_pr_table "$sessions_base" "${session_ids[@]}")

  # Update PR body
  local current_body
  current_body=$(gh pr view "$pr_number" --json body -q '.body' 2>/dev/null || echo "")

  local marker_start="<!-- ai-sessions-start -->"
  local marker_end="<!-- ai-sessions-end -->"
  local new_section
  new_section=$(printf '%s\n\n%s\n\n%s' "$marker_start" "$table" "$marker_end")

  local new_body
  if echo "$current_body" | grep -q "$marker_start"; then
    # Replace existing section
    new_body=$(echo "$current_body" | sed "/$marker_start/,/$marker_end/c\\
$new_section")
  else
    # Append section
    new_body=$(printf '%s\n\n---\n\n%s' "$current_body" "$new_section")
  fi

  gh pr edit "$pr_number" --body "$new_body"
  info "updated PR #$pr_number with ${#session_ids[@]} session(s)"
}

_build_pr_table() {
  local sessions_base="$1"; shift
  local -a sids=("$@")

  echo "### AI Sessions"
  echo ""
  echo "| Session | Goal | Model | Commits |"
  echo "|---------|------|-------|---------|"

  for sid in "${sids[@]}"; do
    for d in "$sessions_base"/*"__${sid}"/; do
      if [[ -d "$d" && -f "$d/meta.json" ]]; then
        local goal model commits_str
        goal=$(jq -r '.goal' "$d/meta.json")
        model=$(jq -r '.model' "$d/meta.json")
        commits_str=$(jq -r '.commits | map(.[0:7]) | join(", ")' "$d/meta.json")
        echo "| \`$sid\` | $goal | $model | $commits_str |"
      fi
    done
  done
}

cmd_list() {
  local sessions_base
  sessions_base=$(_resolve_sessions_base)

  local found=false
  for meta in "$sessions_base"/*/meta.json; do
    [[ -f "$meta" ]] || continue
    found=true
    local sid goal created model branch
    sid=$(jq -r '.short_id' "$meta")
    goal=$(jq -r '.goal' "$meta")
    created=$(jq -r '.created_at' "$meta")
    model=$(jq -r '.model' "$meta")
    branch=$(jq -r '.branch // "—"' "$meta")
    printf '%-10s %-20s %-20s %-30s %s\n' "$sid" "$created" "$model" "$branch" "$goal"
  done

  if [[ "$found" == false ]]; then
    info "no sessions found"
  fi
}

cmd_show() {
  [[ $# -ge 1 ]] || die "usage: ai-session show <short-id>"
  local target_id="$1"

  local session_dir
  session_dir=$(_resolve_session_dir "$target_id") || die "session not found: $target_id"

  [[ -f "$session_dir/meta.json" ]] || die "meta.json not found"
  jq . "$session_dir/meta.json"
}

cmd_resume() {
  [[ $# -ge 1 ]] || die "usage: ai-session resume <id|sha|--pr N>"

  local target="$1"
  local full_path=""

  local toplevel
  toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not a git repository"

  if [[ "$target" == "--pr" ]]; then
    [[ $# -ge 2 ]] || die "usage: ai-session resume --pr <number>"
    local pr_num="$2"
    local sha
    sha=$(gh pr view "$pr_num" --json commits -q '.commits[-1].oid' 2>/dev/null) || die "cannot read PR #$pr_num"
    local session_path
    session_path=$(get_trailer "$sha" "Claude-Session-Path")
    [[ -n "$session_path" ]] || die "no session trailer found in PR #$pr_num"
    # Resolve path — could be external (<project>/sessions/...) or in-tree (.ai/sessions/...)
    full_path=$(_resolve_trailer_path "$session_path" "$toplevel")
  else
    # First, try as a session short ID via resolver
    full_path=$(_resolve_session_dir "$target" 2>/dev/null || true)

    # If not found, try as a commit SHA/ref
    if [[ -z "$full_path" ]]; then
      local session_path
      session_path=$(get_trailer "$target" "Claude-Session-Path")
      if [[ -n "$session_path" ]]; then
        full_path=$(_resolve_trailer_path "$session_path" "$toplevel")
      fi
    fi
  fi

  # Remove trailing slash
  full_path="${full_path%/}"

  [[ -n "$full_path" && -d "$full_path" ]] || die "no session found for: $target"

  local meta="$full_path/meta.json"
  [[ -f "$meta" ]] || die "meta.json not found"

  local claude_sid
  claude_sid=$(jq -r '.claude_session_id // empty' "$meta")

  info "session: $(jq -r '.short_id' "$meta")"
  info "goal:    $(jq -r '.goal' "$meta")"
  info "model:   $(jq -r '.model' "$meta")"

  if [[ -n "$claude_sid" ]]; then
    info "resuming Claude Code session: $claude_sid"
    exec claude --resume "$claude_sid"
  else
    info "no Claude session ID available; launching new session with transcript context"
    if [[ -f "$full_path/transcript.md" ]]; then
      exec claude --prompt "Previous session transcript is at: $full_path/transcript.md"
    else
      exec claude
    fi
  fi
}

cmd_mark_active() {
  # Internal: write breadcrumb file
  # Called by Claude Code PostToolUse hook; receives JSON on stdin
  local toplevel
  toplevel="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  cd "$toplevel"

  mkdir -p "$AI_DIR"

  # Read JSON from stdin (Claude Code hook input)
  local stdin_json=""
  if ! [ -t 0 ]; then
    stdin_json=$(cat)
  fi

  local session_id model timestamp
  timestamp=$(now_iso)

  # Extract session_id from hook input, env var, or generate one
  session_id=$(echo "$stdin_json" | jq -r '.session_id // empty' 2>/dev/null || true)
  [[ -z "$session_id" ]] && session_id="${CLAUDE_SESSION_ID:-$(gen_uuid)}"

  model="${CLAUDE_MODEL:-unknown}"

  # If breadcrumb already exists with the same session, just touch it
  if [[ -f "$BREADCRUMB" ]]; then
    local existing_sid
    existing_sid=$(jq -r '.session_id // empty' "$BREADCRUMB" 2>/dev/null || true)
    if [[ "$existing_sid" == "$session_id" ]]; then
      touch "$BREADCRUMB"
      return 0
    fi
  fi

  jq -n \
    --arg session_id "$session_id" \
    --arg timestamp "$timestamp" \
    --arg model "$model" \
    '{session_id: $session_id, timestamp: $timestamp, model: $model}' \
    > "$BREADCRUMB"
}

# ─── Hook Subcommands ────────────────────────────────────────────────────────

cmd_hook_prepare_commit_msg() {
  local msg_file="${1:-}"
  local commit_source="${2:-}"
  local commit_sha="${3:-}"

  # Skip for merge/squash/amend commits
  [[ "$commit_source" == "merge" || "$commit_source" == "squash" ]] && return 0

  local toplevel
  toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  cd "$toplevel"

  # Check breadcrumb
  [[ -f "$BREADCRUMB" ]] || return 0

  local age
  age=$(file_age_hours "$BREADCRUMB")
  (( age < STALE_HOURS )) || { rm -f "$BREADCRUMB"; return 0; }

  # Read first line of commit message as goal
  local first_line
  first_line=$(head -1 "$msg_file" | sed 's/^#.*//; s/^[[:space:]]*//' || true)
  [[ -n "$first_line" ]] || return 0

  # Create session (always writes to external cache)
  local session_path
  session_path=$(cmd_new --goal "$first_line" --auto 2>/dev/null) || return 0

  # Read short_id from the created session
  local sid session_abs_dir
  session_abs_dir=$(_resolve_trailer_path "$session_path" "$toplevel")

  sid=$(jq -r '.short_id' "$session_abs_dir/meta.json" 2>/dev/null || true)
  [[ -n "$sid" ]] || return 0

  # Commit (and push if remote configured) to session repo
  _session_repo_commit_and_push "session: $first_line"

  # Append trailers to commit message
  git interpret-trailers \
    --trailer "Claude-Session: $sid" \
    --trailer "Claude-Session-Path: $session_path" \
    --in-place "$msg_file" 2>/dev/null || {
    # Fallback: manually append
    printf '\n\nClaude-Session: %s\nClaude-Session-Path: %s\n' "$sid" "$session_path" >> "$msg_file"
  }

  # Remove breadcrumb
  rm -f "$BREADCRUMB"
}

cmd_hook_post_commit() {
  local toplevel
  toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  cd "$toplevel"

  local session_path
  session_path=$(get_trailer HEAD "Claude-Session-Path")
  [[ -n "$session_path" ]] || return 0

  # Resolve meta.json path (external or in-tree)
  local meta
  local full_path
  full_path=$(_resolve_trailer_path "$session_path" "$toplevel")
  meta="$full_path/meta.json"
  [[ -f "$meta" ]] || return 0

  local commit_sha
  commit_sha=$(git rev-parse --short HEAD)

  # Backfill commit SHA into meta.json (dirty write, no amend)
  local tmp
  tmp=$(mktemp)
  jq --arg sha "$commit_sha" '.commits = (.commits + [$sha] | unique)' "$meta" > "$tmp" && mv "$tmp" "$meta"

  # Commit (and push if remote configured) to session repo
  _session_repo_commit_and_push "backfill commit $commit_sha"
}

cmd_hook_pre_push() {
  local remote="${1:-origin}"
  local url="${2:-}"

  local toplevel
  toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  cd "$toplevel"

  # Collect session IDs from commits being pushed
  local -a session_ids=()

  # Read stdin for refs being pushed
  while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    [[ "$local_sha" == "0000000000000000000000000000000000000000" ]] && continue

    local range
    if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
      range="$local_sha"
    else
      range="$remote_sha..$local_sha"
    fi

    while IFS= read -r sid; do
      [[ -n "$sid" ]] && session_ids+=("$sid")
    done < <(git log "$range" --format='%(trailers:key=Claude-Session,valueonly)' 2>/dev/null | grep -v '^$' | sort -u)
  done

  if [[ ${#session_ids[@]} -eq 0 ]]; then
    # Catch-up push if remote configured
    _session_repo_commit_and_push "catch-up push on pre-push" || true
    return 0
  fi

  # Check if current branch has an open PR
  local pr_number
  pr_number=$(gh pr view --json number -q '.number' 2>/dev/null || true)
  [[ -n "$pr_number" ]] || return 0

  # Auto-update PR body
  cmd_pr "${session_ids[@]}" --pr "$pr_number" 2>/dev/null || true

  # Catch-up push of session repo (in case earlier pushes failed)
  _session_repo_commit_and_push "catch-up push on pre-push" || true
}

# ─── Main Dispatch ────────────────────────────────────────────────────────────

cmd_help() {
  cat << 'EOF'
ai-session — Persist Claude Code conversation transcripts as git artifacts

Usage: ai-session <command> [options]

Commands:
  init [--repo <url>] [--cache <path>]
                      Set up hooks + .ai/ directory in current repo.
                      Sessions are stored locally at ~/.ai-sessions/<project>.
                      Use --repo to also push sessions to a remote git repo.
  new                 Create a new session
  attach <id> <sha>   Link session to commit(s)
  pr [<id>...] --pr N Link sessions to PR + update PR body
  list                List all sessions
  show <id>           Print session metadata
  resume <id|sha|--pr N> Launch Claude Code with linked session
  _mark-active        Internal: write breadcrumb (Claude Code hook)

init flags:
  --repo <url>        Also push sessions to a remote git repo
  --cache <path>      Local cache base dir (default: ~/.ai-sessions)

new flags:
  --goal "..."        Summary (required)
  --transcript <path> Transcript file path
  --stdin             Read transcript from stdin
  --auto              Auto-detect latest Claude Code session
  --model <name>      Model name
  --author <name>     Author (default: git user.name)
  --link <url>        Arbitrary URL (repeatable)
  --repo <path>       Override session repo path
EOF
}

main() {
  local cmd="${1:-help}"
  shift || true

  case "$cmd" in
    init)                    cmd_init "$@" ;;
    new)                     cmd_new "$@" ;;
    attach)                  cmd_attach "$@" ;;
    pr)                      cmd_pr "$@" ;;
    list)                    cmd_list "$@" ;;
    show)                    cmd_show "$@" ;;
    resume)                  cmd_resume "$@" ;;
    _mark-active)            cmd_mark_active "$@" ;;
    _hook-prepare-commit-msg) cmd_hook_prepare_commit_msg "$@" ;;
    _hook-post-commit)       cmd_hook_post_commit "$@" ;;
    _hook-pre-push)          cmd_hook_pre_push "$@" ;;
    help|--help|-h)          cmd_help ;;
    version|--version|-v)    echo "ai-session $VERSION" ;;
    *)                       die "unknown command: $cmd" ;;
  esac
}

main "$@"
